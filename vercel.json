{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/docs.js": {
      "maxDuration": 30
    },
    "api/staff-docs.js": {
      "maxDuration": 30
    },
    "api/payment-reviews.js": {
      "maxDuration": 60,
      "includeFiles": "{public/logo.png,node_modules/pdfkit/js/data/**}"
    }
  }
}
